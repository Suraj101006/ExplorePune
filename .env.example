# Copy to .env.local for local dev. On your host, add the same names in its Environment Variables screen.
# Browser-visible (safe to expose):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # a.k.a. "publishable key" in newer Supabase dashboards
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Needed only on your laptop for import scripts, not for hosting:
SUPABASE_SERVICE_ROLE_KEY=

# Optional (chatbot falls back to plain database answers if LLM_API_KEY is empty):
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
ORS_API_KEY=

# Only for the "Delete my account" button on the host; also used by import scripts on your laptop.
# (already listed above as SUPABASE_SERVICE_ROLE_KEY)
# Set to 1 ONLY when running `npm run eval:chat` locally:
CHAT_RATE_LIMIT_OFF=
