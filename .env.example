# Copy to .env.local for local dev. On your host, add the same names in its Environment Variables screen.
# Browser-visible (safe to expose):
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# SERVER ONLY — Firebase Admin SDK.
# Paste the full service account JSON as a single-line string, or set GOOGLE_APPLICATION_CREDENTIALS
# to the path of the service account JSON file.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Automated Feedback Thank-You Email Dispatcher
# (Kept secure on server — personal emails of Suraj Dhok & Sahil Jadhav are never revealed to clients)
# Option A: Standard SMTP (Gmail, Brevo, Resend, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@explorepune.in
FEEDBACK_SENDER_NAME="Suraj Dhok & Sahil Jadhav - Explore Pune"

# Option B: Direct Gmail Service Account / App Password
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# Optional (chatbot falls back to plain database answers if LLM_API_KEY is empty):
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
ORS_API_KEY=

# Set to 1 ONLY when running `npm run eval:chat` locally:
CHAT_RATE_LIMIT_OFF=
