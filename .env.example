# ==============================================================================
# Explore Pune — Production Environment Variables Configuration Template
# All secrets must be set in your secure production hosting environment (e.g. Vercel, Firebase App Hosting).
# NEVER commit real credentials, passwords, or private keys to source control.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Google Gemini AI Server API Key (Server-Side Only)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps / Transit Directions API Key (Server-Side Only - Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Client Configuration (Public Web SDK client identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=punetrail.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=punetrail
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=punetrail.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=783087382799
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_ga4_measurement_id

# Firebase Admin Service Account Key (Server-Side Only - JSON string or path)
# In Google Cloud / Firebase App Hosting, Application Default Credentials (ADC) are used automatically.
FIREBASE_SERVICE_ACCOUNT_KEY=

# SMTP Email Dispatcher (Server-Side Only - Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=explorepune232@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Explore Pune <explorepune232@gmail.com>"
ADMIN_FEEDBACK_EMAIL=explorepune232@gmail.com
FEEDBACK_SENDER_NAME="Explore Pune Team"

# Optional Custom Map Style URL
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
