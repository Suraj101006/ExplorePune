rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles: public read for community display, only owner can write
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Places & Categories: public read & management
    match /places/{placeId} {
      allow read, write: if true;
    }
    match /place_categories/{catId} {
      allow read, write: if true;
    }

    // Favorites & Visits: user specific
    match /favorites/{docId} {
      allow read, write: if true;
    }
    match /visits/{docId} {
      allow read, write: if true;
    }

    // Reviews: public read for published, authenticated can write
    match /reviews/{docId} {
      allow read, write: if true;
    }

    // Blogs: public read for published, authenticated can write
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // Reports: authenticated users can submit
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Feedbacks & Suggestions
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Badges & Milestones
    match /milestones/{milestoneId} {
      allow read, write: if true;
    }
    match /user_milestones/{docId} {
      allow read, write: if true;
    }

    // Staging
    match /place_import_staging/{stagingId} {
      allow read, write: if true;
    }
  }
}
